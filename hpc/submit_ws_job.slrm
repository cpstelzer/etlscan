#!/usr/bin/env bash
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=48G
#SBATCH --time=8:00:00
#SBATCH --job-name=well_plate_analyzer
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=claus-peter.stelzer@uibk.ac.at
#SBATCH --output=%x_%j.out
#SBATCH --error=%x_%j.err

set -eu
# Enable pipefail if the current shell supports it
(set -o pipefail) 2>/dev/null && set -o pipefail

INPUT_DIR="${1:-}"
if [[ -z "$INPUT_DIR" ]]; then
  echo "ERROR: Missing input directory argument."
  echo "Usage: sbatch $0 /path/to/partN"
  exit 1
fi

if [[ ! -d "$INPUT_DIR" ]]; then
  echo "ERROR: Input directory not found: $INPUT_DIR"
  exit 1
fi

# Derive paths
REPO_ROOT="${SCRATCH}/wellscanner/well_plate_analyzer"
PIPELINE_SCRIPT="${REPO_ROOT}/scripts/run_pipeline.py"
CONFIG_FILE="${REPO_ROOT}/config/config.yml"

echo "Job started on: $(hostname)"
echo "Input directory: $INPUT_DIR"
echo "Repo root:       $REPO_ROOT"
echo

module load Anaconda3/2023.10/miniconda-base-2023.10

# Activate conda in non-interactive batch shell
eval "$($UIBK_CONDA_DIR/bin/conda shell.bash hook)"

# Conda activation scripts may reference unset variables; this breaks under `set -u`.
set +u
conda activate wellscan_env
set -u

cd "$REPO_ROOT"

# Limit threaded math libraries to avoid oversubscription and memory spikes
# (Set after activation to avoid being overwritten by environment hooks.)
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

python "$PIPELINE_SCRIPT"   --input_batch_dir "$INPUT_DIR"   --stages all   --config "$CONFIG_FILE"
